{
  "name": "inventario-equipos-bluebay-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del Sistema de Gestión de Inventario y Mantenimiento de Equipos de Cómputo — Blue Bay Grand Esmeralda",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/servidor.ts",
    "start": "tsx src/servidor.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "usuario:admin": "tsx scripts/crear-admin.ts",
    "start:produccion": "tsx scripts/migrar.ts && tsx src/servidor.ts",
    "nube:migrar": "tsx --env-file=.env.nube scripts/migrar.ts",
    "nube:admin": "tsx --env-file=.env.nube scripts/crear-admin.ts",
    "nube:demo": "tsx --env-file=.env.nube prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pdfkit": "^0.17.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "mariadb": "3.4.5",
    "prisma": "7.10.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
