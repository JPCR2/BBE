# Copia este archivo como .env y ajusta usuario/contraseña si usaste otros.
# Formato: mysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE
DATABASE_URL="mysql://inventario:inventario_dev@127.0.0.1:3306/inventario"
SHADOW_DATABASE_URL="mysql://inventario:inventario_dev@127.0.0.1:3306/inventario_shadow"
# Base exclusiva para las pruebas automáticas (se borra y se recrea en cada corrida).
TEST_DATABASE_URL="mysql://inventario:inventario_dev@127.0.0.1:3306/inventario_test"
# Clave para firmar la cookie de sesión del login. Pon una frase larga y al azar
# (por ejemplo, el resultado de: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))").
SESION_SECRETO="cambia-esto-por-una-clave-larga-y-secreta"
